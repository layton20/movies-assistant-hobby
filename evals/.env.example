# Copy to .env and fill in. promptfoo loads .env from this folder automatically.
# Used by the llm-rubric grader (not by the API, which reads user-secrets).
OPENAI_API_KEY=

# Used by hooks/langfuse-scores.js to push eval results as scores. Same project as the API's Langfuse keys.
# Leave blank to skip pushing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
