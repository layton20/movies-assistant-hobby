{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Llm": {
    "Model": "openai/gpt-4o-mini",
    "MaxTokens": 1024,
    "Temperature": 0.3
  },
  "Jev": {
    "Model": "typesafe/jev-1.13",
    "BlockThreshold": 0.5,
    "TimeoutMs": 1500,
    "FailOpen": true
  },
  "Langfuse": {
    "BaseUrl": "https://cloud.langfuse.com"
  }
}